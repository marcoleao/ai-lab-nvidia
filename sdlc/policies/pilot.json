{
  "schema_version": 1,
  "id": "pilot-v1",
  "limits": { "active_inferences": 1, "active_heavy_jobs": 1, "step_attempts": 3, "correction_cycles": 3 },
  "approvals": { "human_required": true, "bind_object_hash": true, "bind_target": true, "bind_policy_hash": true },
  "security": { "block_secrets": true, "blocked_severities": ["critical", "high"], "vulnerability_snapshot_max_age_days": 7 },
  "release": { "require_acceptance": true, "require_backup": true, "promote_same_digest": true },
  "audit": { "append_only": true, "automatic_deletion": false }
}
