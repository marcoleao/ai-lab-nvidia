generator client {
  provider = "prisma-client"
  output = "../packages/db/generated"
}
datasource db {
  provider = "postgresql"
}
enum ItemKind {
  system
  project
  epic
  story
  task
}
model Item {
  id String @id @default(cuid())
  kind ItemKind
  key String @unique
  name String
  description String @default("")
  status String
  projectLifecycle String?
  version Int @default(1)
  archived Boolean @default(false)
  parentId String?
  parentKind ItemKind?
  parent Item? @relation("Hierarchy", fields: [parentId, parentKind], references: [id, kind], onDelete: Restrict)
  children Item[] @relation("Hierarchy")
  data Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repositories Repository[]
  repositoryLinks ItemRepository[]
  chatSession ChatSession?
  proposals PlanProposal[]
  provisioning ProvisioningJob?
  releases Release[] @relation("SystemReleases")
  releasePlanning ReleaseStory? @relation("StoryReleasePlanning")
  conversationProjectLinks ConversationLink[] @relation("ConversationLinkProject")
  conversationStoryLinks ConversationLink[] @relation("ConversationLinkStory")
  @@unique([id, kind])
  @@index([parentId, archived])
  @@index([kind, archived])
}
model Environment {
  id String @id @default(cuid())
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  code String
  liveStatus String @default("not_deployed")
  currentVersion String?
  currentPackageDigest String?
  url String?
  @@unique([repositoryId, code])
}
model Repository {
  id String @id @default(cuid())
  systemId String @unique
  system Item @relation(fields: [systemId], references: [id], onDelete: Restrict)
  key String
  name String
  runtime String
  mode String @default("create")
  gitlabProjectId Int? @unique
  gitlabPath String?
  gitlabUrl String?
  state String @default("pending")
  message String @default("")
  attempts Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links ItemRepository[]
  environments Environment[]
  branchPlanDecisions ReleaseBranchPlanDecision[]
  @@unique([systemId, key])
}
model ItemRepository {
  itemId String
  repositoryId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  @@id([itemId, repositoryId])
}
model AuditInstallation {
  id Int @id
  epochId String
  createdAt DateTime @default(now())
}
model FlowPolicyInstallation {
  id Int @id
  version String
  startedAt DateTime @default(now())
}
model HistoryEvent {
  id String @id @default(cuid())
  itemId String
  ancestorIds String[]
  actorId String
  actorName String
  actorType String @default("human")
  action String
  message String
  payload Json
  timestamp DateTime @default(now())
  schemaVersion Int @default(1)
  auditEpochId String?
  outcome String?
  phase String?
  decision String?
  operationId String?
  requestId String?
  attemptId String?
  causationEventId String?
  subjectType String?
  subjectId String?
  occurredAt DateTime?
  audit Json?
  deduplicationKey String? @unique
  eventDigest String?
  @@index([itemId, timestamp])
  @@index([ancestorIds], type: Gin)
  @@index([operationId, timestamp])
  @@index([schemaVersion, outcome, timestamp])
}
model RequestKey {
  id String @id
  requestHash String
  result Json
  createdAt DateTime @default(now())
}

model ExecutionContractPublication {
 id String @id @default(cuid())
 systemId String
 number Int
 proposalId String
 proposalNumber Int
 reviewId String
 repositoryId String
 repositoryVersion Int
 projectId Int
 branch String
 targetBranch String
 baseSha String
 baseContentDigest String?
 contextDigest String
 content String
 contentDigest String
 reason String
 actorId String
 actorName String
 state String @default("queued")
 version Int @default(1)
 message String
 leaseId String?
 leaseUntil DateTime?
 commitWriteStartedAt DateTime?
 mrWriteStartedAt DateTime?
 commitSha String?
 iid Int?
 url String?
 mrState String?
 confirmedAt DateTime?
 checkedAt DateTime?
 resolvedAt DateTime?
 resolvedById String?
 resolvedByName String?
 resolutionReason String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([systemId,number])
 @@index([state,leaseUntil])
 @@index([systemId,createdAt,id])
}

model ExecutionContractIntegration {
 id String @id @default(cuid())
 publicationId String
 systemId String
 number Int
 kind String
 repositoryId String
 repositoryVersion Int
 projectId Int
 sourceSha String
 targetSha String
 remoteToken String
 reason String
 actorId String
 actorName String
 state String @default("queued")
 version Int @default(1)
 message String
 leaseId String?
 leaseUntil DateTime?
 writeStartedAt DateTime?
 checkedAt DateTime?
 confirmedAt DateTime?
 integrationSha String?
 mergedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([publicationId,number])
 @@index([state,leaseUntil])
}

model ExecutionContractRequest {
 id String @id @default(cuid())
 turnId String @unique
 systemId String
 repositoryId String
 repositoryVersion Int
 projectId Int
 baseSha String
 branch String
 contextDigest String
 context Json
 expectedProposalId String?
 actorId String
 actorName String
 createdAt DateTime @default(now())
 @@index([systemId,createdAt,id])
}
model ExecutionContractProposal {
 id String @id @default(cuid())
 systemId String
 number Int
 requestId String? @unique
 parentId String?
 repositoryId String
 repositoryVersion Int
 projectId Int
 baseSha String
 branch String
 contextDigest String
 content Json?
 summary String
 questions Json
 pendingEntries Json
 digest String
 source String
 actorId String
 actorName String
 createdAt DateTime @default(now())
 @@unique([systemId,number])
 @@index([systemId,createdAt,id])
}
model ExecutionContractReview {
 id String @id @default(cuid())
 proposalId String @unique
 systemId String
 contextDigest String
 reason String
 actorId String
 actorName String
 createdAt DateTime @default(now())
 @@index([systemId,createdAt,id])
}
model Counter {
  scope String @id
  value Int
}
model ProvisioningJob {
  itemId String @id
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  state String @default("pending")
  attempts Int @default(0)
  message String @default("")
  updatedAt DateTime @updatedAt
}
model ChatSession {
  id String @id @default(cuid())
  contextId String @unique
  context Item @relation(fields:[contextId],references:[id],onDelete:Restrict)
  version Int @default(0)
  nextTurn Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turns ChatTurn[]
}
model ChatTurn {
  id String @id @default(cuid())
  sessionId String
  session ChatSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  sequence Int
  kind String @default("chat")
  input String
  output String?
  status String @default("queued")
  model String?
  error String?
  actorId String
  actorName String
  contextSnapshot Json
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proposal PlanProposal?
  @@unique([sessionId,sequence])
  @@index([status,createdAt])
}

// References preserve a single conversation source. Linking is not approval or
// a requirements change; the observed Story revision is retained explicitly.
model ConversationLink {
  id String @id @default(cuid())
  projectId String
  projectKind ItemKind @default(project)
  project Item @relation("ConversationLinkProject", fields:[projectId,projectKind], references:[id,kind], onDelete:Restrict)
  storyId String
  storyKind ItemKind @default(story)
  story Item @relation("ConversationLinkStory", fields:[storyId,storyKind], references:[id,kind], onDelete:Restrict)
  sourceType String
  sourceId String
  sourceVersion Int @default(0)
  storyVersion Int
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([sourceType,sourceId,sourceVersion,storyId,storyVersion], map:"ConversationLink_source_target_revision_key")
  @@index([storyId,createdAt,id])
  @@index([projectId,createdAt,id])
}
model PlanProposal {
  id String @id @default(cuid())
  turnId String @unique
  turn ChatTurn @relation(fields:[turnId],references:[id],onDelete:Restrict)
  projectId String
  project Item @relation(fields:[projectId],references:[id],onDelete:Restrict)
  status String @default("draft")
  version Int @default(1)
  projectVersion Int
  sessionVersion Int
  contextFingerprint String
  content Json
  appliedItemIds Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions PlanRevision[]
}
model PlanRevision {
  proposalId String
  proposal PlanProposal @relation(fields:[proposalId],references:[id],onDelete:Restrict)
  version Int
  content Json
  actorId String
  actorName String
  source String
  createdAt DateTime @default(now())
  @@id([proposalId,version])
}

model ApplicationPreparation {
 id String @id @default(cuid())
 parentId String?
 systemId String
 repositoryId String
 repositoryVersion Int
 projectId Int
 number Int
 kind String
 templateVersion String
 contentDigest String
 files Json
 baseSha String
 branch String
 targetBranch String
 remoteToken String?
 buildBaseImageId String?
 buildWriteStartedAt DateTime?
 statusWriteStartedAt DateTime?
 validationImageId String?
 validationArchiveDigest String?
 validationSize Int?
 technicalTestPassed Boolean @default(false)
 pipelineId Int?
 statusId Int?
 actorId String
 actorName String
 reason String
 state String @default("queued")
 version Int @default(1)
 message String
 leaseId String?
 leaseUntil DateTime?
 commitWriteStartedAt DateTime?
 mrWriteStartedAt DateTime?
 writeStartedAt DateTime?
 commitSha String?
 iid Int?
 url String?
 mrState String?
 confirmedAt DateTime?
 integrationSha String?
 mergedAt DateTime?
 resolvedAt DateTime?
 resolvedById String?
 resolvedByName String?
 resolutionReason String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([systemId,number])
 @@index([state,createdAt])
 @@index([parentId,number])
}

model DevelopmentBuild {
 id String @id @default(cuid())
 storyId String
 systemId String
 executionId String
 integrationReferenceId String
 repositoryId String
 repositoryVersion Int
 projectId Int
 number Int
 sourceSha String
 targetBranch String
 contractDigest String
 unitId String
 baseImageId String
 policyVersion String
 reason String
 actorId String
 actorName String
 state String @default("queued")
 version Int @default(1)
 message String
 leaseId String?
 leaseUntil DateTime?
 dispatchStartedAt DateTime?
 startedAt DateTime?
 finishedAt DateTime?
 imageId String?
 archiveDigest String?
 artifactSize Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([storyId,number])
