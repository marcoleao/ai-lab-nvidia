model StoryExecution {
  id String @id @default(cuid())
  storyId String
  repositoryId String
  storyVersion Int
  state String @default("queued")
  stage String @default("specification")
  snapshot Json
  specification Json?
  patch Json?
  branch String?
  commitSha String?
  mergeRequestUrl String?
  error String?
  actorId String
  actorName String
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  discussionVersion Int @default(0)
  discussionProposal Json?
  allowDependencies Boolean @default(false)
  messages ExecutionMessage[]
  @@index([storyId,createdAt])
  @@index([state,createdAt])
}

// Drafts are separate from the content currently approved for execution.
model StorySpecificationDraft {
  storyId String @id
  version Int @default(1)
  baseRevision Int @default(0)
  content Json
  actorId String
  actorName String
  source String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Applied content is immutable; audit events reference these controlled sources.
model StorySpecificationRevision {
  id String @id @default(cuid())
  storyId String
  number Int
  content Json
  actorId String
  actorName String
  source String
  createdAt DateTime @default(now())
  @@unique([storyId, number])
  @@index([storyId, createdAt, id])
}
model TaskResultRevision {
  id String @id @default(cuid())
  taskId String
  version Int
  summary String
  evidence Json
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([taskId, version])
  @@index([taskId, createdAt, id])
}
model ExecutionMessage {
  id String @id @default(cuid())
  executionId String
  execution StoryExecution @relation(fields:[executionId],references:[id],onDelete:Restrict)
  sequence Int
  role String
  content String
  state String @default("succeeded")
  intent String @default("discuss")
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([executionId,sequence])
}

enum ReleaseCompositionState {
  OPEN
  CLOSED
  CANCELED
}

model MergeOperation {
  id String @id @default(cuid())
  executionId String @unique
  storyId String
  projectId Int
  iid Int
  sourceBranch String
  targetBranch String
  sha String
  state String @default("tracking")
  actorId String?
  actorName String?
  requestedAt DateTime?
  finishedAt DateTime?
  origin String?
  mergedBy String?
  message String?
  blocks Json @default("[]")
  leaseId String?
  leaseUntil DateTime?
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  discussionVersion Int @default(0)
  turns MergeDiscussionTurn[]
  @@index([state, checkedAt])
}

model MergeIntegrationReference {
  id String @id @default(cuid())
  operationId String @unique
  executionId String
  storyId String
  repositoryId String
  repositoryVersion Int
  projectId Int
  iid Int
  sourceBranch String
  targetBranch String
  sourceSha String
  mergeCommitSha String?
  squashCommitSha String?
  integrationSha String?
  mergedAt DateTime?
  mergedBy String?
  policyVersion String
  observedAt DateTime @default(now())
  @@index([storyId, observedAt, id])
}

model MergeHistoryCloseOperation {
  id String @id @default(cuid())
  mergeOperationId String
  executionId String
  storyId String
  projectId Int
  iid Int
  sourceBranch String
  targetBranch String
  sha String
  remoteUpdatedAt String
  contextDigest String
  reason String
  actorId String
  actorName String
  state String @default("queued")
  version Int @default(1)
  message String
  leaseId String?
  leaseUntil DateTime?
  writeStartedAt DateTime?
  reconcileOnly Boolean @default(false)
  checkedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([mergeOperationId, createdAt, id])
  @@index([state, leaseUntil])
  @@index([storyId, state])
}

model MergeHistoryResolution {
  id String @id @default(cuid())
  operationId String @unique
  executionId String
  storyId String
  repositoryId String
  repositoryVersion Int
  projectId Int
  iid Int
  sourceBranch String
  targetBranch String
  sourceSha String
  observedState String
  observedAt DateTime
  decidedAt DateTime @default(now())
  actorId String
  actorName String
  reason String
  policyVersion String
  @@index([storyId, decidedAt, id])
}

model MergeDiscussionTurn {
  id String @id @default(cuid())
  operationId String
  operation MergeOperation @relation(fields:[operationId],references:[id],onDelete:Restrict)
  sequence Int
  input String
  specialist String @default("merge")
  output String?
  state String @default("queued")
  error String?
  actorId String
  actorName String
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([operationId,sequence])
  @@index([state,createdAt])
}

// Authorizes only removal of Draft, never merge, deployment or task completion.
model MergePreparation {
  id String @id @default(cuid())
  operationId String @unique
  executionId String
  storyId String
  sha String
  storyVersion Int
  state String @default("queued")
  actorId String
  actorName String
  message String?
  leaseId String?
  leaseUntil DateTime?
  writeStartedAt DateTime?
  reconcileOnly Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state,updatedAt])
}

// Planning is independent from immutable candidate manifests and deployments.
// Only DRAFT creation/composition is exposed until the real execution exists.
model QualityCheck {
  id String @id @default(cuid())
  executionId String
  storyId String
  kind String
  sha String
  baseSha String
  policyVersion String
  state String @default("queued")
  actorId String
  actorName String
  summary String?
  findings Json @default("[]")
  evidence Json?
  error String?
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([executionId,kind,createdAt])
  @@index([state,createdAt])
}

// Operational work is separate from the approved planning revision.
model WorkActivity {
  id String @id @default(cuid())
  storyId String
  repositoryId String
  kind String
  scopeKey String @unique
  taskId String?
  currentAttemptId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts WorkAttempt[]
  taskLinks WorkTaskLink[]
  @@index([storyId,kind])
}
model WorkAttempt {
  id String @id @default(cuid())
  activityId String
  activity WorkActivity @relation(fields:[activityId],references:[id],onDelete:Restrict)
  sourceType String
  sourceId String
  sourceKey String @unique
  revision String?
  state String @default("queued")
  stage String @default("queued")
  provider String?
  actorId String
  actorName String
  queuedAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  waitingSince DateTime?
  heartbeatAt DateTime?
  heartbeatIntervalMs Int @default(15000)
  heartbeatStaleAfterMs Int @default(45000)
  leaseId String?
  errorCategory String?
  summary String?
  events WorkEvent[]
  @@index([activityId,queuedAt])
  @@index([state,queuedAt])
}
model WorkTaskLink {
  activityId String
  activity WorkActivity @relation(fields:[activityId],references:[id],onDelete:Restrict)
  taskId String
  scope String
  completion String @default("manual_evidence")
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@id([activityId,taskId])
  @@index([taskId])
}
model WorkEvent {
  id String @id @default(cuid())
  attemptId String
  attempt WorkAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
  key String
  kind String
  stage String
  message String
  provider String?
  category String?
  payload Json @default("{}")
  timestamp DateTime @default(now())
  @@unique([attemptId,key])
  @@index([timestamp,kind])
}

model Release {
  id String @id @default(cuid())
  key String @unique
  name String
  systemId String
  systemKind ItemKind @default(system)
  system Item @relation("SystemReleases", fields: [systemId, systemKind], references: [id, kind], onDelete: Restrict)
  compositionStatus ReleaseCompositionState @default(OPEN)
  flowEnvironment String? @default("DEV")
  canceledAt DateTime?
  canceledById String?
  canceledByName String?
  cancellationReason String?
  version Int @default(1)
  createdById String
  createdByName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stories ReleaseStory[]
  compositionRevisions ReleaseCompositionRevision[]
  branchPlanDecisions ReleaseBranchPlanDecision[]
  @@index([systemId, createdAt, id])
  @@index([compositionStatus, createdAt, id])
}

// Immutable complete compositions. ReleaseStory is the current planning link;
// it is not the retained source of earlier or future frozen compositions.
model ReleaseCompositionRevision {
  id String @id @default(cuid())
  releaseId String
  release Release @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  branchPlanDecisions ReleaseBranchPlanDecision[]
  number Int
  releaseRecordVersion Int
  compositionStatus ReleaseCompositionState
  flowEnvironment String?
  source String
  storyCount Int
  stories Json
  digest String?
  actorId String?
  actorName String?
  operationId String?
  createdAt DateTime @default(now())
  @@unique([releaseId, number])
  @@index([releaseId, createdAt, id])
  @@index([createdAt, id])
  @@index([stories(ops: JsonbPathOps)], type: Gin)
}

model ReleaseStory {
  storyId String @id
  storyKind ItemKind @default(story)
  story Item @relation("StoryReleasePlanning", fields: [storyId, storyKind], references: [id, kind], onDelete: Restrict)
  releaseId String
  release Release @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  plannedStoryVersion Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storyId, storyKind])
  @@index([releaseId])
}

// Local planning decisions are immutable. They are not branch executions or
// evidence of production, code adoption, package content or development approval.
model ReleaseBranchPreparation {
 id String @id @default(cuid())
 releaseId String
 number Int
 decisionId String
 releaseRecordVersion Int
 compositionRevisionId String
 repositoryId String
 repositoryRecordVersion Int
 gitlabProjectId Int
 branchName String
 defaultBranch String
 baseSha String
 state String @default("queued")
 message String
 actorId String
 actorName String
 leaseId String?
 leaseUntil DateTime?
 writeStartedAt DateTime?
 reconcileOnly Boolean @default(false)
 observedSha String?
 protectionReady Boolean @default(false)
 confirmedAt DateTime?
 checkedAt DateTime?
 errorCode String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([releaseId,number])
 @@index([state,updatedAt])
}

model ReleaseBranchPlanDecision {
 id String @id @default(cuid())
 releaseId String
 release Release @relation(fields:[releaseId],references:[id],onDelete:Restrict)
 number Int
 releaseRecordVersion Int
 compositionRevisionId String
 composition ReleaseCompositionRevision @relation(fields:[compositionRevisionId],references:[id],onDelete:Restrict)
 compositionNumber Int
 repositoryId String
