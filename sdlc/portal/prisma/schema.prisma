 repositoryRecordVersion Int
 gitlabProjectId Int
 branchName String
 defaultBranch String
 defaultBranchSha String
 observedBranchSha String?
 baseSha String
 scenario String
 policyVersion String
 policy Json
 policyDigest String
 contextDigest String
 decisionDigest String
 reason String
 actorId String
 actorName String
 operationId String
 observedAt DateTime
 createdAt DateTime @default(now())
 @@unique([releaseId,number])
 @@index([releaseId,createdAt,id])
}

