generator client {
  provider = "prisma-client"
  output = "../packages/db/generated"
}
datasource db {
  provider = "postgresql"
}
enum ItemKind {
  system
  project
  epic
  story
  task
}
model Item {
  id String @id @default(cuid())
  kind ItemKind
  key String @unique
  name String
  description String @default("")
  status String
  projectLifecycle String?
  version Int @default(1)
  archived Boolean @default(false)
  parentId String?
  parentKind ItemKind?
  parent Item? @relation("Hierarchy", fields: [parentId, parentKind], references: [id, kind], onDelete: Restrict)
  children Item[] @relation("Hierarchy")
  data Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repositories Repository[]
  repositoryLinks ItemRepository[]
  chatSession ChatSession?
  proposals PlanProposal[]
  provisioning ProvisioningJob?
  releases Release[] @relation("SystemReleases")
  releasePlanning ReleaseStory? @relation("StoryReleasePlanning")
  conversationProjectLinks ConversationLink[] @relation("ConversationLinkProject")
  conversationStoryLinks ConversationLink[] @relation("ConversationLinkStory")
  @@unique([id, kind])
  @@index([parentId, archived])
  @@index([kind, archived])
}
model Environment {
  id String @id @default(cuid())
  repositoryId String
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  code String
  liveStatus String @default("not_deployed")
  currentVersion String?
  currentPackageDigest String?
  url String?
  @@unique([repositoryId, code])
}
model Repository {
  id String @id @default(cuid())
  systemId String
  system Item @relation(fields: [systemId], references: [id], onDelete: Restrict)
  key String
  name String
  runtime String
  mode String @default("create")
  gitlabProjectId Int? @unique
  gitlabPath String?
  gitlabUrl String?
  state String @default("pending")
  message String @default("")
  attempts Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links ItemRepository[]
  environments Environment[]
  @@unique([systemId, key])
}
model ItemRepository {
  itemId String
  repositoryId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  @@id([itemId, repositoryId])
}
model AuditInstallation {
  id Int @id
  epochId String
  createdAt DateTime @default(now())
}
model FlowPolicyInstallation {
  id Int @id
  version String
  startedAt DateTime @default(now())
}
model HistoryEvent {
  id String @id @default(cuid())
  itemId String
  ancestorIds String[]
  actorId String
  actorName String
  actorType String @default("human")
  action String
  message String
  payload Json
  timestamp DateTime @default(now())
  schemaVersion Int @default(1)
  auditEpochId String?
  outcome String?
  phase String?
  decision String?
  operationId String?
  requestId String?
  attemptId String?
  causationEventId String?
  subjectType String?
  subjectId String?
  occurredAt DateTime?
  audit Json?
  deduplicationKey String? @unique
  eventDigest String?
  @@index([itemId, timestamp])
  @@index([ancestorIds], type: Gin)
  @@index([operationId, timestamp])
  @@index([schemaVersion, outcome, timestamp])
}
model RequestKey {
  id String @id
  requestHash String
  result Json
  createdAt DateTime @default(now())
}
model Counter {
  scope String @id
  value Int
}
model ProvisioningJob {
  itemId String @id
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  state String @default("pending")
  attempts Int @default(0)
  message String @default("")
  updatedAt DateTime @updatedAt
}
model ChatSession {
  id String @id @default(cuid())
  contextId String @unique
  context Item @relation(fields:[contextId],references:[id],onDelete:Restrict)
  version Int @default(0)
  nextTurn Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turns ChatTurn[]
}
model ChatTurn {
  id String @id @default(cuid())
  sessionId String
  session ChatSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  sequence Int
  kind String @default("chat")
  input String
  output String?
  status String @default("queued")
  model String?
  error String?
  actorId String
  actorName String
  contextSnapshot Json
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proposal PlanProposal?
  @@unique([sessionId,sequence])
  @@index([status,createdAt])
}

// References preserve a single conversation source. Linking is not approval or
// a requirements change; the observed Story revision is retained explicitly.
model ConversationLink {
  id String @id @default(cuid())
  projectId String
  projectKind ItemKind @default(project)
  project Item @relation("ConversationLinkProject", fields:[projectId,projectKind], references:[id,kind], onDelete:Restrict)
  storyId String
  storyKind ItemKind @default(story)
  story Item @relation("ConversationLinkStory", fields:[storyId,storyKind], references:[id,kind], onDelete:Restrict)
  sourceType String
  sourceId String
  sourceVersion Int @default(0)
  storyVersion Int
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([sourceType,sourceId,sourceVersion,storyId,storyVersion], map:"ConversationLink_source_target_revision_key")
  @@index([storyId,createdAt,id])
  @@index([projectId,createdAt,id])
}
model PlanProposal {
  id String @id @default(cuid())
  turnId String @unique
  turn ChatTurn @relation(fields:[turnId],references:[id],onDelete:Restrict)
  projectId String
  project Item @relation(fields:[projectId],references:[id],onDelete:Restrict)
  status String @default("draft")
  version Int @default(1)
  projectVersion Int
  sessionVersion Int
  contextFingerprint String
  content Json
  appliedItemIds Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions PlanRevision[]
}
model PlanRevision {
  proposalId String
  proposal PlanProposal @relation(fields:[proposalId],references:[id],onDelete:Restrict)
  version Int
  content Json
  actorId String
  actorName String
  source String
  createdAt DateTime @default(now())
  @@id([proposalId,version])
}

model StoryExecution {
  id String @id @default(cuid())
  storyId String
  repositoryId String
  storyVersion Int
  state String @default("queued")
  stage String @default("specification")
  snapshot Json
  specification Json?
  patch Json?
  branch String?
  commitSha String?
  mergeRequestUrl String?
  error String?
  actorId String
  actorName String
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  discussionVersion Int @default(0)
  discussionProposal Json?
  allowDependencies Boolean @default(false)
  messages ExecutionMessage[]
  @@index([storyId,createdAt])
  @@index([state,createdAt])
}

// Drafts are separate from the content currently approved for execution.
model StorySpecificationDraft {
  storyId String @id
  version Int @default(1)
  baseRevision Int @default(0)
  content Json
  actorId String
  actorName String
  source String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Applied content is immutable; audit events reference these controlled sources.
model StorySpecificationRevision {
  id String @id @default(cuid())
  storyId String
  number Int
  content Json
  actorId String
  actorName String
  source String
  createdAt DateTime @default(now())
  @@unique([storyId, number])
  @@index([storyId, createdAt, id])
}
model TaskResultRevision {
  id String @id @default(cuid())
  taskId String
  version Int
  summary String
  evidence Json
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([taskId, version])
  @@index([taskId, createdAt, id])
}
model ExecutionMessage {
  id String @id @default(cuid())
  executionId String
  execution StoryExecution @relation(fields:[executionId],references:[id],onDelete:Restrict)
  sequence Int
  role String
  content String
  state String @default("succeeded")
  intent String @default("discuss")
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@unique([executionId,sequence])
}

enum ReleaseStage {
  DRAFT
  QA
  HML
  PRODUCTION
  REJECTED
}

model MergeOperation {
  id String @id @default(cuid())
  executionId String @unique
  storyId String
  projectId Int
  iid Int
  sourceBranch String
  targetBranch String
  sha String
  state String @default("tracking")
  actorId String?
  actorName String?
  requestedAt DateTime?
  finishedAt DateTime?
  origin String?
  mergedBy String?
  message String?
  blocks Json @default("[]")
  leaseId String?
  leaseUntil DateTime?
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  discussionVersion Int @default(0)
  turns MergeDiscussionTurn[]
  @@index([state, checkedAt])
}

model MergeDiscussionTurn {
  id String @id @default(cuid())
  operationId String
  operation MergeOperation @relation(fields:[operationId],references:[id],onDelete:Restrict)
  sequence Int
  input String
  output String?
  state String @default("queued")
  error String?
  actorId String
  actorName String
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([operationId,sequence])
  @@index([state,createdAt])
}

// Planning is independent from immutable candidate manifests and deployments.
// Only DRAFT creation/composition is exposed until the real execution exists.
model QualityCheck {
  id String @id @default(cuid())
  executionId String
  storyId String
  kind String
  sha String
  baseSha String
  policyVersion String
  state String @default("queued")
  actorId String
  actorName String
  summary String?
  findings Json @default("[]")
  evidence Json?
  error String?
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([executionId,kind,createdAt])
  @@index([state,createdAt])
}

// Operational work is separate from the approved planning revision.
model WorkActivity {
  id String @id @default(cuid())
  storyId String
  repositoryId String
  kind String
  scopeKey String @unique
  taskId String?
  currentAttemptId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts WorkAttempt[]
  taskLinks WorkTaskLink[]
  @@index([storyId,kind])
}
model WorkAttempt {
  id String @id @default(cuid())
  activityId String
  activity WorkActivity @relation(fields:[activityId],references:[id],onDelete:Restrict)
  sourceType String
  sourceId String
  sourceKey String @unique
  revision String?
  state String @default("queued")
  stage String @default("queued")
  provider String?
  actorId String
  actorName String
  queuedAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  waitingSince DateTime?
  heartbeatAt DateTime?
  heartbeatIntervalMs Int @default(15000)
  heartbeatStaleAfterMs Int @default(45000)
  leaseId String?
  errorCategory String?
  summary String?
  events WorkEvent[]
  @@index([activityId,queuedAt])
  @@index([state,queuedAt])
}
model WorkTaskLink {
  activityId String
  activity WorkActivity @relation(fields:[activityId],references:[id],onDelete:Restrict)
  taskId String
  scope String
  completion String @default("manual_evidence")
  actorId String
  actorName String
  createdAt DateTime @default(now())
  @@id([activityId,taskId])
  @@index([taskId])
}
model WorkEvent {
  id String @id @default(cuid())
  attemptId String
  attempt WorkAttempt @relation(fields:[attemptId],references:[id],onDelete:Restrict)
  key String
  kind String
  stage String
  message String
  provider String?
  category String?
  payload Json @default("{}")
  timestamp DateTime @default(now())
  @@unique([attemptId,key])
  @@index([timestamp,kind])
}

model Release {
  id String @id @default(cuid())
  key String @unique
  name String
  systemId String
  systemKind ItemKind @default(system)
  system Item @relation("SystemReleases", fields: [systemId, systemKind], references: [id, kind], onDelete: Restrict)
  stage ReleaseStage @default(DRAFT)
  version Int @default(1)
  createdById String
  createdByName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stories ReleaseStory[]
  @@index([systemId, createdAt, id])
  @@index([stage, createdAt, id])
}

model ReleaseStory {
  storyId String @id
  storyKind ItemKind @default(story)
  story Item @relation("StoryReleasePlanning", fields: [storyId, storyKind], references: [id, kind], onDelete: Restrict)
  releaseId String
  release Release @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  plannedStoryVersion Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([storyId, storyKind])
  @@index([releaseId])
}
